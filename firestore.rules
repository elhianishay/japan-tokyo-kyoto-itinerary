rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /points/{pointId} {
      allow read, write: if signedIn();
    }

    match /guide/{sectionId} {
      allow read, write: if signedIn();
    }

    match /_meta/{docId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
